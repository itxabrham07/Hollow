{
  "moduleId": "module_sensor_firewall",
  "name": "Sensor & Mic Hardware Firewall",
  "version": 1,
  "minCoreVersion": 1,
  "entryClass": "com.example.isolation.module.sensorfirewall.SensorFirewallPayload",
  "features": [
    "Silent PCM Microphone Guard",
    "Camera2 Black Frame Shield",
    "Gyroscope & Accelerometer Telemetry Scrubber",
    "Ultrasonic Background Beacon Jammer"
  ],
  "permissions": [
    "android.permission.RECORD_AUDIO",
    "android.permission.CAMERA"
  ],
  "hookTargets": [
    "android.media.AudioRecord",
    "android.hardware.camera2.CameraManager",
    "android.hardware.SystemSensorManager"
  ],
  "accentColorHex": "0xFF4F46E5"
}
