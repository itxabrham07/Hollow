<?xml version="1.0" encoding="utf-8"?>
<!--
    Hollow "H" Emblem — geometric faceted letter mark
    Matches HollowSplashEmblem Canvas drawing in OnboardingAuthScreen.kt
    Viewbox 108x108, safe zone 72x72 centered at (18,18)→(90,90)
    H pillars + crossbar in slate/onyx faceted style
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- LEFT PILLAR — top facet (lighter slate) -->
    <!-- Canvas: moveTo(w*0.08, 0) lineTo(w*0.44, h*0.14) lineTo(w*0.44, h*0.58) lineTo(w*0.08, h*0.44) -->
    <!-- Scale to 72×72 safe zone offset +18: multiply coords by 72 then +18 -->
    <path
        android:fillColor="#1E293B"
        android:pathData="
            M 23.76,18
            L 49.68,28.08
            L 49.68,59.76
            L 23.76,49.68
            Z" />

    <!-- LEFT PILLAR — bottom facet (darker onyx) -->
    <!-- Canvas: moveTo(w*0.08, h*0.44) lineTo(w*0.44, h*0.58) lineTo(w*0.44, h) lineTo(w*0.08, h*0.86) -->
    <path
        android:fillColor="#0F172A"
        android:pathData="
            M 23.76,49.68
            L 49.68,59.76
            L 49.68,90
            L 23.76,79.92
            Z" />

    <!-- RIGHT PILLAR — top facet (medium slate) -->
    <!-- Canvas: moveTo(w*0.56, h*0.14) lineTo(w*0.92, 0) lineTo(w*0.92, h*0.44) lineTo(w*0.56, h*0.58) -->
    <path
        android:fillColor="#334155"
        android:pathData="
            M 58.32,28.08
            L 84.24,18
            L 84.24,49.68
            L 58.32,59.76
            Z" />

    <!-- RIGHT PILLAR — bottom facet (dark slate) -->
    <!-- Canvas: moveTo(w*0.56, h*0.58) lineTo(w*0.92, h*0.44) lineTo(w*0.92, h*0.86) lineTo(w*0.56, h) -->
    <path
        android:fillColor="#1E293B"
        android:pathData="
            M 58.32,59.76
            L 84.24,49.68
            L 84.24,79.92
            L 58.32,90
            Z" />

    <!-- CENTER CROSSBAR — dynamic folding bridge (mid-slate) -->
    <!-- Canvas: moveTo(w*0.44, h*0.32) lineTo(w*0.56, h*0.42) lineTo(w*0.56, h*0.68) lineTo(w*0.44, h*0.58) -->
    <path
        android:fillColor="#475569"
        android:pathData="
            M 49.68,41.04
            L 58.32,48.24
            L 58.32,66.96
            L 49.68,59.76
            Z" />

</vector>
